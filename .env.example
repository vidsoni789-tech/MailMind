# Anthropic API (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LangSmith (optional — for tracing and debugging)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=langmail

# Gmail OAuth2 — generated by running: langmail setup
# Do NOT fill these in manually
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Model config (optional overrides)
LANGMAIL_MODEL=anthropic:claude-sonnet-4-20250514
LANGMAIL_SUMMARIZATION_MODEL=anthropic:claude-haiku-4-5-20251001

GOOGLE_API_KEY=your_google_api_key_here